    "catalog": false,
    "catalog_tagline": "Run your contact center in the cloud: route every call, chat, and message to the right agent, capture and score interactions, and keep teams staffed and on target.",
    "catalog_description": "Bring every customer conversation onto one cloud platform. Calls, chats, emails, SMS, and social messages land in unified queues and route to the agent best suited to handle them, with self-service menus and AI assistance deflecting and speeding up the simple requests. Agents see the customer's history across channels as soon as the interaction connects, and wrap up each contact with a clear outcome code that feeds reporting and follow-up.\n\nBehind the scenes you get the tooling to run the operation: live queue dashboards and service-level alerts, agent presence and availability tracking, and full interaction recording for quality and compliance. Supervisors review and score recorded interactions, coach agents on what to improve, and watch real-time metrics so they can shift staffing before service levels slip."
  },
  "capabilities": [
    {
      "capabilities": {
        "capability_code": "SLA-MGMT",
        "capability_name": "SLA and OLA Management",
        "description": "Service-level, operational-level, and underpinning-contract definitions; attachment to work items by priority/category/customer tier; breach detection; escalation triggers; breach reporting. Applies across internal IT services, external customer services, contact-centre work, and project services."
      }
    },
    {
      "capabilities": {
        "capability_code": "CCAAS-OMNI-ROUTE",
        "capability_name": "Omnichannel Routing and Queueing",
        "description": "Unified ingestion of voice, chat, email, SMS, and social interactions into skills-based queues, with automatic call distribution (ACD) that matches each contact to the best-fit available agent by skill, priority, and customer tier. Includes queue prioritization, overflow, and routing-profile administration."
      }
    },
    {
      "capabilities": {
        "capability_code": "CCAAS-IVR-SELF",
        "capability_name": "IVR and Self-Service Flows",
        "description": "Visual flow runtime for interactive voice response menus, callback offers, and digital self-service that authenticate, collect intent, deflect simple requests, and hand off to a live queue when needed. Covers prompt design, DTMF and speech capture, and flow versioning."
      }
    },
    {
      "capabilities": {
        "capability_code": "CCAAS-AGENT-DESK",
        "capability_name": "Agent Desktop and Interaction Handling",
        "description": "The agent workspace that presents the connected interaction with cross-channel customer context, controls for hold, transfer, conference, and consult, after-call wrap-up, and disposition coding. Tracks agent presence and availability states that feed routing and adherence."
      }
    },
    {
      "capabilities": {
        "capability_code": "CCAAS-REC-CAPTURE",
        "capability_name": "Interaction Recording and Capture",
        "description": "Capture and retention of voice recordings and transcripts (and screen capture where licensed) across interactions, with consent handling, pause/resume for sensitive data, and retention policy enforcement so recordings are available for quality, dispute, and compliance review."
      }
    },
    {
      "capabilities": {
        "capability_code": "CCAAS-QM-COACH",
        "capability_name": "Quality Management and Coaching",
        "description": "Supervisor review and scoring of recorded interactions against evaluation forms, calibration across evaluators, and coaching assignment to close performance gaps. Drives agent improvement plans tied to disposition and outcome data."
      }
    },
    {
      "capabilities": {
        "capability_code": "CCAAS-RT-ANALYTICS",
        "capability_name": "Real-Time and Historical Analytics",
        "description": "Live queue and agent dashboards with service-level, abandon-rate, and occupancy metrics and threshold alerting, plus historical reporting aggregated by queue, agent, skill, and disposition for trend analysis and staffing decisions."
      }
    },
    {
      "capabilities": {
        "capability_code": "CCAAS-WEM-ADHERE",
        "capability_name": "Workforce Engagement and Adherence",
        "description": "Tracking of agent state changes and time-in-state against expected schedules to measure adherence and auxiliary-time breaches, surfacing intraday staffing signals. Consumes forecasts and schedules mastered in the workforce-management domain rather than owning them."
      }
    }
  ],

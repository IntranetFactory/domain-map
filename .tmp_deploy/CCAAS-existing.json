      "to_state": "",
      "event_category": "lifecycle"
    },
    {
      "event_name": "agent_state.changed",
      "description": "An agent's state (available / busy / wrap / away / lunch) has changed. WFM adherence and queue routing both react.",
      "from_state": "",
      "to_state": "",
      "event_category": "state_change"
    },
    {
      "event_name": "agent_state.aux_threshold_exceeded",
      "description": "Agent has exceeded the allowed time in an auxiliary (non-productive) state. WFM flags adherence breach; supervisor is notified.",
      "from_state": "",
      "to_state": "",
      "event_category": "threshold"
    },
    {
      "event_name": "disposition_code.applied",

  "modules": [
    {
      "domain_module_code": "CCAAS-DESKTOP",
      "domain_module_name": "Agent Desktop and Interactions",
      "module_kind": "full",
      "description": "The live interaction workspace. Owns the support session as the unit of agent work, the contact record captured for every interaction, and agent_states that track presence and availability. Realizes the agent-desktop and workforce-engagement/adherence capabilities. Consumes WFM schedules to compare actual state against plan rather than mastering scheduling here."
    },
    {
      "domain_module_code": "CCAAS-ROUTING",
      "domain_module_name": "Routing and Queues",
      "module_kind": "full",
      "description": "The ACD and flow engine. Owns omnichannel ingestion, skills-based queueing, and the IVR/self-service flow runtime that places each interaction into the right queue. Realizes routing and IVR capabilities. Masters queue_statistics as the computed view of queue health and disposition_codes as the catalog of outcome codes applied downstream. Consumes CRM customers and KMS knowledge as routing and self-service context."
    },
    {
      "domain_module_code": "CCAAS-QUALITY",
      "domain_module_name": "Quality and Analytics",
      "module_kind": "full",
      "description": "Post-interaction quality and reporting. Owns call recordings as the captured evidence of each interaction, interaction_evaluations as supervisor scoring against forms, and evaluation_forms as the reusable scorecard catalog. Realizes the recording, quality-management/coaching, and analytics capabilities. Consumes contact_records and support_sessions as the interactions under review and SLA definitions for breach reporting."
    }
  ],

  "trigger_events": [
    {
      "event_name": "call.escalated",
      "description": "A contact-center call has been escalated to a supervisor or specialist queue. The originating agent's customer-case may need re-assignment.",
      "from_state": "in_progress",
      "to_state": "escalated",
      "event_category": "state_change"
    },
    {
      "event_name": "sentiment.negative",
      "description": "Real-time or post-call sentiment analysis flagged the customer interaction as negative. CSM should triage for outreach; supervisor intervention may be needed mid-call.",
      "from_state": "",
      "to_state": "",
      "event_category": "signal"
    },
    {
      "event_name": "contact_record.captured",
      "description": "A CCaaS contact (call, chat, email, social) has been recorded. CSM links to the customer case; WFM uses for agent occupancy.",

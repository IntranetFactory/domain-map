  "modules": [
    {
      "domain_module_code": "AIOPS-EVENT-CORRELATION",
      "domain_module_name": "Event Correlation",
      "module_kind": "full",
      "description": "The real-time signal-reduction half of AIOps. Ingests high-volume events, alerts, metrics, and traces from the monitoring estate, detects anomalies against learned baselines, correlates and deduplicates related signals into single incidents, and applies suppression rules (including planned-change windows) to cut alert noise. Masters event_correlations, anomaly_detections, and alert_suppression_rules; consumes monitoring_events, monitoring_alerts, distributed_traces, and configuration_items owned by OBS / RMM / CMDB. Used standalone by ops teams that only need noise reduction, or alongside Predictive Intelligence for the full closed loop."
    },
    {
      "domain_module_code": "AIOPS-PREDICTIVE-INTELLIGENCE",
      "domain_module_name": "Predictive Intelligence",
      "module_kind": "full",
      "description": "The analytical, forward-looking half of AIOps. Forecasts incidents and capacity problems, elevates predictive signals above action thresholds, infers probable root cause for correlated incidents, and runs the ML training lifecycle (including drift detection) that keeps the detection and prediction models trustworthy. Masters predictive_signals, incident_predictions, root_cause_analyses, and ml_model_training_records; consumes data_pipelines and configuration_items owned by DATA-AI-PLAT / CMDB. Typically deployed alongside Event Correlation, which supplies the correlated incidents that root-cause and prediction reason over."
    }
  ],

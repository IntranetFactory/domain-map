    "catalog": false,
    "catalog_tagline": "Cut through alert noise and turn a flood of IT signals into a short list of correlated, root-caused issues your teams can act on before users feel the impact.",
    "catalog_description": "An AIOps platform sits across the high-volume telemetry your IT estate produces every second, metrics, logs, traces, events, and alerts, and uses machine learning and statistical analysis to find the few patterns that matter. Instead of paging on every threshold breach, it groups related signals into a single correlated incident, filters out duplicate and flapping alerts, and surfaces the probable root cause so responders start from an answer rather than a blank screen.\n\nOperations and engineering teams use it to detect anomalies against learned baselines, suppress noise during planned changes, and receive early warning of predicted outages and capacity problems while there is still time to act. Correlated incidents and high-confidence predictions flow straight into incident and problem workflows, and suppression decisions flow back to the monitoring layer, so the whole operational loop stays in sync.\n\nBehind the scenes, detection and prediction models are continuously retrained and watched for drift, keeping the signal accurate as the environment changes. The result is fewer pages, faster mean time to resolution, and a clearer picture of service health, so on-call teams spend their time fixing problems instead of triaging alerts."
  },
  "capabilities": [
    {
      "capabilities": {
        "capability_code": "AIOPS-EVENT-CORRELATION",
        "capability_name": "Event Correlation",
        "description": "Group related events, alerts, and signals from across the monitored estate into a single correlated incident using ML and pattern analysis, so responders see one issue instead of a flood of raw alerts."
      }
    },
    {
      "capabilities": {
        "capability_code": "AIOPS-ANOMALY-DETECTION",
        "capability_name": "Anomaly Detection",
        "description": "Detect deviations from learned baselines across metrics, logs, and traces, flagging outliers and abnormal behavior that fixed thresholds would miss."
      }
    },
    {
      "capabilities": {
        "capability_code": "AIOPS-ALERT-NOISE-REDUCTION",
        "capability_name": "Alert Noise Reduction",
        "description": "Deduplicate, suppress, and silence flapping or low-value alerts, including during planned changes, so on-call teams are paged only on signals that matter."
      }
    },
    {
      "capabilities": {
        "capability_code": "AIOPS-ROOT-CAUSE-ANALYSIS",
        "capability_name": "Root Cause Analysis",
        "description": "Infer the probable root cause of a correlated incident from topology, change, and signal evidence, so responders start from an answer rather than a blank screen."
      }
    },
    {
      "capabilities": {
        "capability_code": "AIOPS-PREDICTIVE-INSIGHTS",
        "capability_name": "Predictive Insights",
        "description": "Forecast outages, capacity exhaustion, and error storms ahead of impact by elevating predictive signals and high-confidence incident predictions into proactive workflows."
      }
    },
    {
      "capabilities": {
        "capability_code": "AIOPS-MODEL-OPERATIONS",
        "capability_name": "Detection Model Operations",
        "description": "Train, retrain, and monitor the detection and prediction models behind the platform, watching for drift so the signal stays accurate as the environment changes."
      }
    }
  ],

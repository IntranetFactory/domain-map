    "search_vector": "'center':2A 'data':1A 'dcim':5C 'infrastructure':3A 'management':4A",
    "notes": "",
    "catalog": false,
    "catalog_tagline": "See, power, cool, and plan every rack in your data centers from one live model, so you never run out of space, power, or cooling by surprise.",
    "catalog_description": "Data center infrastructure management gives facilities and IT infrastructure teams a single, authoritative model of the physical estate: every site, rack, and cabinet, the power chain that feeds them, the cooling that keeps them within range, and the cables and ports that connect them. Instead of spreadsheets and tribal knowledge, you get a live register of what is installed, where it sits, and how much headroom is left.\n\nOperators track power from the incoming circuit through distribution units and uninterruptible supplies down to the outlet, monitor temperature and humidity from cabinet-level sensors, and map physical connectivity port by port and cable by cable. When a circuit overloads, a cooling unit fails, or an environmental threshold is breached, the event is captured and routed to the teams and systems that need to act.\n\nOn top of the asset and telemetry layer sits capacity planning: forward-looking projections of power, cooling, space, and bandwidth per site and zone. Planners use that headroom view to schedule growth, justify build-outs, and negotiate colocation with confidence, while changes to the physical layer flow out to the configuration database and downstream operations so the rest of IT stays in step."
  },
  "capabilities": [
    {
      "capabilities": {
        "capability_code": "DCIM-ASSET-REG",
        "capability_name": "Physical Asset and Space Register",
        "description": "Authoritative model of the physical estate: sites, rooms, rows, cabinets, racks, and rack-unit occupancy, recording what is installed, where it sits, and how much space remains."
      }
    },
    {
      "capabilities": {
        "capability_code": "DCIM-POWER-CHAIN",
        "capability_name": "Power Chain Modeling",
        "description": "End-to-end power path from incoming circuit through distribution units and uninterruptible supplies down to the outlet, with phase balance, redundancy, and draw against rated capacity tracked at each link."
      }
    },
    {
      "capabilities": {
        "capability_code": "DCIM-THERMAL",
        "capability_name": "Cooling and Thermal Management",
        "description": "Modeling of cooling units, thermal zones, and airflow alongside cabinet-level temperature and humidity, keeping equipment inside its operating envelope."
      }
    },
    {
      "capabilities": {
        "capability_code": "DCIM-ENV-MON",
        "capability_name": "Environmental Monitoring",
        "description": "Continuous capture of sensor telemetry (temperature, humidity, smoke, water leak, airflow) with threshold alarming routed to the teams and systems that must act."
      }
    },
    {
      "capabilities": {
        "capability_code": "DCIM-CAP-PLAN",
        "capability_name": "Capacity Planning",
        "description": "Forward-looking projection of power, cooling, space, and bandwidth headroom per site and zone, with what-if modeling to schedule growth and justify build-outs."
      }
    },
    {
      "capabilities": {
        "capability_code": "DCIM-CONN-MAP",
        "capability_name": "Physical Connectivity Mapping",
        "description": "Port-by-port and cable-by-cable map of physical connectivity, including patch panels and trunk runs, feeding the configuration database and network operations."
      }
    },
    {
      "capabilities": {
        "capability_code": "DCIM-MAC",
        "capability_name": "Moves, Adds, and Changes Workflow",
        "description": "Structured request, approval, and execution of equipment installs, decommissions, and relocations across the floor, keeping the live model in step with physical reality."
      }
    }
  ],

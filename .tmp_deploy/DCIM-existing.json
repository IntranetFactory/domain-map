  "modules": [
    {
      "domain_module_code": "DCIM-ASSET-SPACE",
      "domain_module_name": "Asset and Space Management",
      "module_kind": "full",
      "description": "Owns the physical-asset register and the space hierarchy: sites, rooms, rows, cabinets, racks, and rack-unit occupancy, plus the moves/adds/changes workflow that keeps the live model aligned with what is physically installed. This module is the system of record for where every piece of equipment sits and how much rack and floor space remains."
    },
    {
      "domain_module_code": "DCIM-POWER-ENV",
      "domain_module_name": "Power and Environmental Monitoring",
      "module_kind": "full",
      "description": "Models the full power chain from incoming circuit through PDUs and uninterruptible supplies to the outlet, the cooling estate that keeps equipment in range, and the environmental sensor telemetry that triggers alarms. This module realizes the power, thermal, and environmental capabilities and emits the failure, overload, failover, and threshold-breach events the catalog already hands off to ITSM, ITOM, and AIOPS."
    },
    {
      "domain_module_code": "DCIM-CAP-CONN",
      "domain_module_name": "Capacity and Connectivity Planning",
      "module_kind": "full",
      "description": "Combines forward-looking capacity planning for power, cooling, space, and bandwidth with the physical connectivity map of ports and cables. Capacity plans roll up utilization and growth forecasts per site and zone (handed off to SPM for build-out decisions), while the port and cable register feeds the configuration database and is cross-validated by NPMD."
    }
  ],

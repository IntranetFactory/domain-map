      "module_kind": "full",
      "domain_module_code": "ATS-BACKGROUND-CHECKS",
      "domain_id": 56,
      "description": "Pre-employment background-check orchestration with adverse-action workflow. Coordinates external vendor handoffs and gates offer-to-firm conversion on clearance. Requires an external `send_email` tool for FCRA adverse-action notices.",
      "industry_id": null,
      "catalog_tagline": "Run compliant background screening with the adverse-action flow built in.",
      "catalog_description": "Order screening packages, track each component to completion, and adjudicate results in one place. The full FCRA flow (disclosures, summary-of-rights acknowledgments, pre-adverse and adverse-action notices, and dispute handling) is modeled as part of the workflow.\n\nScreening is scoped by jurisdiction, so deployments outside FCRA jurisdictions enable only what applies to them.",
      "specification_requirements": "",
      "record_status": "new",
      "search_vector": "'background':1A 'checks':2A 'full':3C"
    }
